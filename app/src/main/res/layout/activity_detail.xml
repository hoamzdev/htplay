<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".detail.DetailActivity">


    <androidx.media3.ui.PlayerView
        android:id="@+id/media_play"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size250"
        android:contentDescription="@null"
        android:background="@color/black"
        app:resize_mode="fit"
        app:surface_type="texture_view"
        app:use_controller="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/secondary_color"
        app:layout_constraintBottom_toBottomOf="@id/media_play"
        app:layout_constraintEnd_toEndOf="@id/media_play"
        app:layout_constraintStart_toStartOf="@id/media_play"
        app:layout_constraintTop_toTopOf="@id/media_play" />


    <ImageView
        android:id="@+id/iv_drop"
        android:layout_width="@dimen/size35"
        android:layout_height="@dimen/size35"
        android:layout_marginStart="@dimen/size10"
        android:layout_marginTop="@dimen/size40"
        android:contentDescription="@string/accessibility_back"
        android:src="@drawable/iv_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_name_movie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size8"
        android:layout_marginTop="@dimen/size10"
        android:ellipsize="end"
        android:fontFamily="@font/font_figtree_regular"
        android:maxLines="1"
        tools:text="Queen of tears"
        android:textColor="@color/white"
        android:textSize="@dimen/sizesp18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/media_play" />


    <TextView
        android:id="@+id/tv_current_episode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size8"
        android:layout_marginTop="@dimen/size5"
        android:ellipsize="end"
        android:fontFamily="@font/font_figtree_regular"
        android:maxLines="1"
        android:paddingBottom="@dimen/size10"
        android:visibility="gone"
        tools:text="Episode 10"
        android:textColor="@color/white"
        android:textSize="@dimen/sizesp14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_name_movie" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scroll_detail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_current_episode" />

</androidx.constraintlayout.widget.ConstraintLayout>
