<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".detail.DetailActivity">


    <androidx.media3.ui.PlayerView
        android:id="@+id/media_play"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size250"
        android:contentDescription="@null"
        android:background="@color/black"
        app:resize_mode="fit"
        app:use_controller="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/secondary_color"
        app:layout_constraintBottom_toBottomOf="@id/media_play"
        app:layout_constraintEnd_toEndOf="@id/media_play"
        app:layout_constraintStart_toStartOf="@id/media_play"
        app:layout_constraintTop_toTopOf="@id/media_play" />


    <ImageView
        android:id="@+id/iv_drop"
        android:layout_width="@dimen/size35"
        android:layout_height="@dimen/size35"
        android:layout_marginStart="@dimen/size16"
        android:layout_marginTop="@dimen/size40"
        android:contentDescription="@null"
        android:src="@drawable/iv_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_name_movie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size8"
        android:layout_marginTop="@dimen/size10"
        android:ellipsize="end"
        android:fontFamily="@font/font_figtree_regular"
        android:maxLines="1"
        android:paddingBottom="@dimen/size10"
        android:text="Queen of tears"
        android:textColor="@color/white"
        android:textSize="@dimen/sizesp18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/media_play" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_detail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_name_movie">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/size16">

            <ImageView
                android:id="@+id/iv_star"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size8"
                android:layout_marginTop="@dimen/size10"
                android:contentDescription="@null"
                android:src="@drawable/ic_star"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tv_star"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size5"
                android:layout_marginTop="@dimen/size2"
                android:fontFamily="@font/font_figtree_regular"
                android:text="9.5"
                android:textColor="@color/white"
                android:textSize="@dimen/sizesp14"
                app:layout_constraintBottom_toBottomOf="@id/iv_star"
                app:layout_constraintStart_toEndOf="@id/iv_star"
                app:layout_constraintTop_toTopOf="@id/iv_star" />


            <View
                android:id="@+id/v_1"
                android:layout_width="@dimen/size1"
                android:layout_height="@dimen/size16"
                android:layout_marginStart="@dimen/size6"
                android:background="@color/white"
                app:layout_constraintBottom_toBottomOf="@id/iv_star"
                app:layout_constraintStart_toEndOf="@id/tv_star"
                app:layout_constraintTop_toTopOf="@id/iv_star" />

            <TextView
                android:id="@+id/tv_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size6"
                android:layout_marginTop="@dimen/size2"
                android:fontFamily="@font/font_figtree_regular"
                android:text="2026"
                android:textColor="@color/white"
                android:textSize="@dimen/sizesp14"
                app:layout_constraintBottom_toBottomOf="@id/iv_star"
                app:layout_constraintStart_toEndOf="@id/v_1"
                app:layout_constraintTop_toTopOf="@id/iv_star" />


            <View
                android:id="@+id/v_2"
                android:layout_width="@dimen/size1"
                android:layout_height="@dimen/size16"
                android:layout_marginStart="@dimen/size6"
                android:background="@color/white"
                app:layout_constraintBottom_toBottomOf="@id/iv_star"
                app:layout_constraintStart_toEndOf="@id/tv_year"
                app:layout_constraintTop_toTopOf="@id/iv_star" />

            <TextView
                android:id="@+id/tv_country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size5"
                android:layout_marginTop="@dimen/size2"
                android:fontFamily="@font/font_figtree_regular"
                android:text="Vietnam"
                android:textColor="@color/white"
                android:textSize="@dimen/sizesp14"
                app:layout_constraintBottom_toBottomOf="@id/iv_star"
                app:layout_constraintStart_toEndOf="@id/v_2"
                app:layout_constraintTop_toTopOf="@id/iv_star" />


            <View
                android:id="@+id/v_3"
                android:layout_width="@dimen/size1"
                android:layout_height="@dimen/size16"
                android:layout_marginStart="@dimen/size6"
                android:background="@color/white"
                app:layout_constraintBottom_toBottomOf="@id/iv_star"
                app:layout_constraintStart_toEndOf="@id/tv_country"
                app:layout_constraintTop_toTopOf="@id/iv_star" />

            <TextView
                android:id="@+id/tv_genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size6"
                android:layout_marginTop="@dimen/size2"
                android:fontFamily="@font/font_figtree_regular"
                android:text="Cotume"
                android:textColor="@color/white"
                android:textSize="@dimen/sizesp14"
                app:layout_constraintBottom_toBottomOf="@id/iv_star"
                app:layout_constraintStart_toEndOf="@id/v_3"
                app:layout_constraintTop_toTopOf="@id/iv_star" />


            <ImageView
                android:id="@+id/iv_download"
                android:layout_width="@dimen/size24"
                android:layout_height="@dimen/size24"
                android:layout_marginStart="@dimen/size8"
                android:layout_marginTop="@dimen/size10"
                android:contentDescription="@null"
                android:src="@drawable/ic_download"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_star" />

            <ImageView
                android:id="@+id/iv_favorite"
                android:layout_width="@dimen/size24"
                android:layout_height="@dimen/size24"
                android:layout_marginStart="@dimen/size20"
                android:layout_marginTop="@dimen/size10"
                android:contentDescription="@null"
                android:src="@drawable/iv_favo"
                app:layout_constraintStart_toEndOf="@id/iv_download"
                app:layout_constraintTop_toBottomOf="@id/iv_star" />


            <TextView
                android:id="@+id/tv_about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size8"
                android:layout_marginTop="@dimen/size14"
                android:fontFamily="@font/font_figtree_regular"
                android:text="About"
                android:textColor="@color/secondary_color"
                android:textSize="@dimen/sizesp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_download" />


            <TextView
                android:id="@+id/tv_episodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size20"
                android:layout_marginTop="@dimen/size14"
                android:fontFamily="@font/font_figtree_regular"
                android:text="Episodes"
                android:textColor="@color/white"
                android:textSize="@dimen/sizesp16"
                app:layout_constraintStart_toEndOf="@id/tv_about"
                app:layout_constraintTop_toBottomOf="@id/iv_download" />

            <View
                android:id="@+id/v_land_1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size1"
                android:layout_marginTop="@dimen/size5"
                android:background="@color/white"
                app:layout_constraintTop_toBottomOf="@id/tv_about" />

            <View
                android:id="@+id/v_land_about"
                android:layout_width="0dp"
                android:layout_height="@dimen/size1"
                android:layout_marginTop="@dimen/size5"
                android:layout_marginEnd="-15dp"
                android:background="@color/secondary_color"
                app:layout_constraintEnd_toEndOf="@id/tv_about"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_about" />


            <View
                android:id="@+id/v_land_episodes"
                android:layout_width="0dp"
                android:layout_height="@dimen/size1"
                android:layout_marginStart="-10dp"
                android:layout_marginTop="@dimen/size5"
                android:layout_marginEnd="-10dp"
                android:background="@color/white"
                app:layout_constraintEnd_toEndOf="@id/tv_episodes"
                app:layout_constraintStart_toStartOf="@id/tv_episodes"
                app:layout_constraintTop_toBottomOf="@id/tv_about" />


            <TextView
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/v_land_1"
                android:layout_marginTop="@dimen/size14"
                android:textSize="@dimen/sizesp13"
                android:fontFamily="@font/font_figtree_regular"
                android:text="@string/aldready_have_an_account"
                android:textColor="@color/white"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginHorizontal="@dimen/size8"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rc_episodes"
                android:nestedScrollingEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="6"
                tools:listitem="@layout/item_episode"
                app:layout_constraintTop_toBottomOf="@id/v_land_1"
                android:layout_marginTop="@dimen/size14"
                android:layout_marginHorizontal="@dimen/size8"/>


            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier_content_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierAllowsGoneWidgets="false"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="tv_content,rc_episodes" />

            <TextView
                android:id="@+id/tv_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="More like this"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrier_content_bottom"
                android:layout_marginHorizontal="@dimen/size8"
                android:layout_marginTop="@dimen/size10"
                android:textColor="@color/white"
                android:textSize="@dimen/sizesp16"
                android:fontFamily="@font/font_figtree_regular"/>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rc_more_like_this"
                android:nestedScrollingEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:visibility="invisible"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:orientation="horizontal"
                tools:listitem="@layout/item_movie"
                app:layout_constraintTop_toBottomOf="@id/tv_more"
                android:layout_marginTop="@dimen/size8"
                android:layout_marginHorizontal="@dimen/size8"/>

            <TextView
                android:id="@+id/tv_more_country"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size8"
                android:layout_marginTop="@dimen/size14"
                android:fontFamily="@font/font_figtree_regular"
                android:textColor="@color/white"
                android:textSize="@dimen/sizesp16"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rc_more_like_this"
                tools:text="More from South Korea" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rc_more_like_this_country"
                android:nestedScrollingEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:orientation="horizontal"
                tools:listitem="@layout/item_movie"
                app:layout_constraintTop_toBottomOf="@id/tv_more_country"
                android:layout_marginTop="@dimen/size10"
                android:layout_marginHorizontal="@dimen/size8"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
