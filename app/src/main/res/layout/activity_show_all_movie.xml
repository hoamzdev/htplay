<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".home.home.ShowAllMovieActivity">

    <ImageView
        android:id="@+id/ic_back"
        android:layout_width="@dimen/size35"
        android:layout_height="@dimen/size35"
        android:src="@drawable/iv_back"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_title"
        android:layout_marginBottom="@dimen/size3"
        app:layout_constraintBottom_toBottomOf="@id/tv_title"
        android:layout_marginStart="@dimen/size16"/>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/ic_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/size40"
        android:layout_marginStart="@dimen/size10"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/app_name"
        android:textSize="@dimen/sizesp20"
        android:fontFamily="@font/font_poppins_regular"
        android:textColor="@color/white"/>


    <include
        android:id="@+id/genre_tabs"
        layout="@layout/item_home_genre_tabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rc_movies"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/genre_tabs"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="@dimen/size10"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingBottom="@dimen/size30"
        android:clipToPadding="false"/>

</androidx.constraintlayout.widget.ConstraintLayout>
