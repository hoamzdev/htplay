<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".favorite.ChooseFavoritesActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size16"
            android:layout_marginTop="@dimen/size70"
            android:fontFamily="@font/font_figtree_bold"
            android:text="Favorites Movies"
            android:textColor="@color/white"
            android:textSize="@dimen/size30"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size16"
            android:layout_marginTop="@dimen/size3"
            android:fontFamily="@font/font_poppins_regular"
            android:includeFontPadding="true"
            android:text="Choose 3 genres you like"
            android:textColor="@color/gray_color"
            android:textSize="@dimen/size16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rc_favorites"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/size16"
            android:layout_marginTop="@dimen/size6"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_2"
            android:layout_marginBottom="@dimen/sizesp10"
            app:spanCount="3"
            tools:listitem="@layout/item_movie_select_favorite" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_Choose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/size16"
            android:layout_marginTop="@dimen/sizesp10"
            android:layout_marginBottom="@dimen/size30"
            android:background="@drawable/bgr_buton_primary"
            android:fontFamily="@font/font_figtree_semi_bold"
            android:paddingVertical="@dimen/size15"
            android:text="Choose"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/sizesp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rc_favorites"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
