<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size130"
    android:paddingVertical="@dimen/size5"
    android:paddingHorizontal="@dimen/size8"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/iv_placeholder"
            android:contentDescription="@null"/>

    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/card_poster"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="@dimen/size10"
        android:layout_marginTop="@dimen/size10"
        android:textColor="@color/primary_color"
        app:layout_constraintBottom_toTopOf="@id/tv_episode"
        android:fontFamily="@font/font_figtree_regular"
        android:textSize="@dimen/size18"/>


    <TextView
        android:id="@+id/tv_episode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Episode 10"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/card_poster"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        android:layout_marginStart="@dimen/size10"
        android:layout_marginEnd="@dimen/size10"
        app:layout_constraintBottom_toTopOf="@id/tv_size"
        android:textColor="@color/gray_color"
        android:fontFamily="@font/font_figtree_regular"
        android:textSize="@dimen/size16"/>


    <TextView
        android:id="@+id/tv_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="100 MB"
        android:maxLines="2"
        android:background="@color/primary_color"
        android:ellipsize="end"
        android:padding="@dimen/size6"
        app:layout_constraintStart_toEndOf="@id/card_poster"
        app:layout_constraintTop_toBottomOf="@id/tv_episode"
        android:layout_marginStart="@dimen/size10"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textColor="@color/white"
        android:fontFamily="@font/font_figtree_regular"
        android:textSize="@dimen/size14"/>


    <ImageView
        android:id="@+id/iv_delete"
        android:contentDescription="@string/download_delete"
        android:layout_width="@dimen/size26"
        android:layout_height="@dimen/size26"
        android:src="@drawable/trash_sharp"
        android:layout_marginEnd="@dimen/size10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_size"
        app:layout_constraintBottom_toBottomOf="@id/tv_size"/>

</androidx.constraintlayout.widget.ConstraintLayout>
