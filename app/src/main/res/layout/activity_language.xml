<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".language.LanguageActivity">

    <TextView
        android:id="@+id/tv_choose_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/language_choose"
        android:textColor="@color/white"
        android:fontFamily="@font/font_figtree_regular"
        android:textSize="@dimen/size20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/size40"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rc_languages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tv_choose_language"
        app:layout_constraintBottom_toTopOf="@id/btn_save_language"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="@dimen/size16"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="vertical"
        tools:listitem="@layout/item_language"
        android:layout_marginTop="@dimen/size20"
        android:layout_marginBottom="@dimen/size10"
        android:paddingBottom="@dimen/size30"
        android:clipToPadding="false"/>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_save_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/size20"
        android:layout_marginHorizontal="@dimen/size16"
        android:background="@drawable/bgr_buton_primary"
        android:paddingVertical="@dimen/size14"
        android:text="@string/language_save"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:fontFamily="@font/font_figtree_regular"
        android:textSize="@dimen/sizesp18"/>


</androidx.constraintlayout.widget.ConstraintLayout>
