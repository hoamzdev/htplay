<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/size16">

    <TextView
        android:id="@+id/tv_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="More like this"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginHorizontal="@dimen/size8"
        android:layout_marginTop="@dimen/size10"
        android:textColor="@color/white"
        android:textSize="@dimen/sizesp16"
        android:fontFamily="@font/font_figtree_regular"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rc_more_like_this"
        android:nestedScrollingEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="invisible"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="horizontal"
        tools:listitem="@layout/item_movie"
        app:layout_constraintTop_toBottomOf="@id/tv_more"
        android:layout_marginTop="@dimen/size8"
        android:layout_marginHorizontal="@dimen/size8"/>

    <TextView
        android:id="@+id/tv_more_country"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size8"
        android:layout_marginTop="@dimen/size14"
        android:fontFamily="@font/font_figtree_regular"
        android:textColor="@color/white"
        android:textSize="@dimen/sizesp16"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rc_more_like_this"
        tools:text="More from South Korea" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rc_more_like_this_country"
        android:nestedScrollingEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="horizontal"
        tools:listitem="@layout/item_movie"
        app:layout_constraintTop_toBottomOf="@id/tv_more_country"
        android:layout_marginTop="@dimen/size10"
        android:layout_marginHorizontal="@dimen/size8"/>

</androidx.constraintlayout.widget.ConstraintLayout>
