<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bgr_language"
    android:layout_marginBottom="@dimen/size4"
    android:layout_marginTop="@dimen/size4"
    android:layout_height="@dimen/size55">

    <ImageView
        android:id="@+id/iv_logo_country"
        android:layout_width="@dimen/size35"
        android:layout_height="@dimen/size35"
        android:src="@drawable/iv_lan_vietnam"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="@dimen/size16"
        android:contentDescription="@null"/>

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Tiếng Việt"
        app:layout_constraintStart_toEndOf="@id/iv_logo_country"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="@dimen/size12"
        android:textColor="@color/white"
        android:fontFamily="@font/font_figtree_regular"
        android:textSize="@dimen/sizesp16"/>

    <View
        android:id="@+id/selected_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size55"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/item_language_selected"/>

    <ImageView
        android:id="@+id/iv_checked"
        android:layout_width="@dimen/size35"
        android:layout_height="@dimen/size35"
        android:src="@drawable/ic_checked"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="@dimen/size10"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        android:contentDescription="@null"/>


</androidx.constraintlayout.widget.ConstraintLayout>
