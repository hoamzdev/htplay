<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size50"
    android:background="@drawable/bgr_bottom_nav"
    android:paddingHorizontal="@dimen/size10">

    <LinearLayout
        android:id="@+id/ln_tab_home"
        android:contentDescription="@string/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ln_tab_favorite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/size20"
            android:layout_height="@dimen/size20"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:src="@drawable/ic_home"
            app:tint="@color/bottom_nav_item_color" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/ln_tab_favorite"
        android:contentDescription="@string/nav_favorites"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ln_tab_download"
        app:layout_constraintStart_toEndOf="@id/ln_tab_home"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/size20"
            android:layout_height="@dimen/size20"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:src="@drawable/ic_favorite"
            app:tint="@color/bottom_nav_item_color" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/ln_tab_download"
        android:contentDescription="@string/nav_downloads"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ln_tab_user"
        app:layout_constraintStart_toEndOf="@id/ln_tab_favorite"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/size20"
            android:layout_height="@dimen/size20"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:src="@drawable/ic_download"
            app:tint="@color/bottom_nav_item_color" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/ln_tab_user"
        android:contentDescription="@string/nav_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ln_tab_download"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/size20"
            android:layout_height="@dimen/size20"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:src="@drawable/ic_user"
            app:tint="@color/bottom_nav_item_color" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
