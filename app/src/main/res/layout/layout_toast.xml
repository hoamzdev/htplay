<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_toast"
    android:paddingVertical="@dimen/size5"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/size25"
        android:layout_height="@dimen/size25"
        app:strokeWidth="0dp"
        android:layout_marginStart="@dimen/size16"
        app:strokeColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/size8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo"
            android:contentDescription="@null"/>

    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:maxWidth="260dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/aldready_have_an_account"
        app:layout_constraintStart_toEndOf="@id/iv_logo"
        android:layout_marginEnd="@dimen/size16"
        android:fontFamily="@font/font_poppins_regular"
        android:textSize="@dimen/sizesp10"
        android:textColor="@color/white"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintBottom_toBottomOf="@id/iv_logo"
        android:layout_marginStart="@dimen/size10"/>


</androidx.constraintlayout.widget.ConstraintLayout>
